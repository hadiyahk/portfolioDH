    }

        .hero-content h1 {
            font-size: 3em;
            font-weight: bold;
        }

        .hero-content p {
            position: relative;
            padding-left: 10px;
        }

            .hero-content p:before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                height: 100%;
                width: 4px;
                background-color: #FFD700;
            }



    .hero-video {
        flex: 2;
        width: 50%;
        height: 50%;
        object-fit: cover;
        border-radius: 10px;
    }




    .navbar {
        display: flex;
        justify-content: center;
        margin: 20px 0;
    }

        .navbar a {
            text-decoration: none;
            color: #fff;
            padding: 10px 20px;
            margin: 0 15px;
            font-size: 1.2em;
            position: relative;
            font-weight: 400;
            transition: all 0.3s ease;
        }

            .navbar a:hover {
                color: #B2FFFF;
            }

            .navbar a:before {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                height: 2px;
                width: 100%;
                background-color: #B2FFFF;
                transform: scaleX(0);
                transition: transform 0.3s ease;
            }

            .navbar a:hover:before {
                transform: scaleX(1);
            }

        .navbar .active {
            color: #B2FFFF;
            font-weight: bold;
        }

            .navbar .active:before {
                transform: scaleX(1);
            }


    section {
        padding: 40px;
        margin: 20px auto;
        max-width: 1100px;
    }

    h1 {
        color: white;
    }

    h2 {
        color: white;
        font-size: 2em;
        margin-bottom: 10px;
    }

    h3 {
        color: lightblue;
        font-size: 2em;
        margin-bottom: 10px;
    }

    p {
        font-size: 1.1em;
        margin-bottom: 20px;
        color: white;
    }

    ul {
        list-style: none;
        padding-left: 0;
        color: white;
    }




    .project-section {
        display: none;
    }

    .active {
        display: block;
    }

    /* Text on left, photos on right */
    .artifact-flex {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 60px;
    }

    /* Text takes up most of the space */
    .artifact-content {
        flex: 1;
        min-width: 0;
    }

    /* Photos stay small on the right */
    .artifact-images {
        flex: 0 0 180px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        align-items: center;
    }

        /* Override the original large photo container */
        .artifact-images .artifact-photo {
            width: 100%;
            max-width: 180px;
            min-height: 0;
            margin: 0;
            padding: 0;
            border: none;
            background: none;
        }

            /* Small, proportional photos */
            .artifact-images .artifact-photo img {
                width: 100%;
                height: auto;
                border-radius: 10px;
                object-fit: contain;
            }

    /* Mobile responsiveness */
    @@media (max-width: 768px) {
        .artifact-flex {
            flex-direction: column;
            gap: 25px;
        }

        .artifact-images {
            flex-basis: auto;
            width: 100%;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;
        }

            .artifact-images .artifact-photo {
                width: 140px;
            }
