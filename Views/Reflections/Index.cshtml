<script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
<script>
    AOS.init();


    function filterRefelctions(category) {
        const allReflections = document.querySelectorAll('.project-section');
        const allLinks = document.querySelectorAll('.navbar a');
        

        allLinks.forEach(link => link.classList.remove('active'));


        const clickedLink = Array.from(allLinks).find(link => link.textContent.toLowerCase() === category.replace('-', ' '));
        if (clickedLink) clickedLink.classList.add('active');


        allReflections.forEach(refelctions => {
            if (category === 'all' || refelctions.classList.contains(category)) {
                refelctions.classList.add('active');
                AOS.refresh();
            } else {
                refelctions.classList.remove('active');
            }
        });
    }


    filterRefelctions('all');
</script>